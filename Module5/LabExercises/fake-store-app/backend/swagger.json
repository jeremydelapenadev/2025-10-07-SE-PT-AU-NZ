{
  "openapi": "3.0.3",
  "info": {
    "title": "Fake Store API",
    "version": "1.0.0",
    "description": "API for fetching products from the fake store via local backend"
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "paths": {
    "/api/products": {
      "get": {
        "summary": "Get all products",
        "description": "Returns a list of all products from the fake store. Each product has id, title, description, price, category, and image.",
        "responses": {
          "200": {
            "description": "List of all products",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "integer", "example": 1 },
                      "title": {
                        "type": "string",
                        "example": "Fjallraven Backpack"
                      },
                      "description": {
                        "type": "string",
                        "example": "A durable backpack for everyday use..."
                      },
                      "price": { "type": "number", "example": 109.95 },
                      "category": {
                        "type": "string",
                        "example": "men's clothing"
                      },
                      "image": {
                        "type": "string",
                        "example": "https://fakestoreapi.com/img/81fPKd-2AYL._AC_SL1500_.jpg"
                      }
                    },
                    "required": [
                      "id",
                      "title",
                      "description",
                      "price",
                      "category",
                      "image"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "parameters": [
    {
      "name": "category",
      "in": "query",
      "description": "Filter products by category",
      "required": false,
      "schema": {
        "type": "string",
        "enum": [
          "electronics",
          "jewelery",
          "men's clothing",
          "women's clothing"
        ]
      }
    }
  ]
}
