{
  "openapi": "3.0.3",
  "info": {
    "title": "Fake Store API",
    "version": "1.0.0",
    "description": "API for fetching products from the FakeStore API via a local backend"
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "paths": {
    "/api/products": {
      "get": {
        "summary": "Get products",
        "description": "Fetch products from FakeStore API with optional query filters",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "description": "Filter products by category",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "electronics",
                "jewelery",
                "men's clothing",
                "women's clothing"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Limit the number of products returned",
            "required": false,
            "schema": {
              "type": "integer",
              "example": 5
            }
          },
          {
            "name": "search",
            "in": "query",
            "description": "Search products by title",
            "required": false,
            "schema": {
              "type": "string",
              "example": "shirt"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of products",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "integer",
                        "example": 1
                      },
                      "title": {
                        "type": "string",
                        "example": "Fjallraven Backpack"
                      },
                      "description": {
                        "type": "string",
                        "example": "Your perfect pack for everyday use..."
                      },
                      "price": {
                        "type": "number",
                        "example": 109.95
                      },
                      "category": {
                        "type": "string",
                        "example": "men's clothing"
                      },
                      "image": {
                        "type": "string",
                        "example": "https://fakestoreapi.com/img/81fPKd-2AYL._AC_SL1500_.jpg"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    }
  }
}